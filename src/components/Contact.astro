---
import portfolio from "@/data/portfolio";
import SectionLabel from "./SectionLabel.astro";

const d = portfolio;
---

<section id="contact" class="section section--contact">
  <div class="container">
    <div class="contact-inner fade-in">
      <SectionLabel text="Contato" />
      <h2 class="contact-title">
        Vamos construir<br />
        <span class="contact-title__accent">algo juntos</span>
      </h2>
      <p class="contact-desc">
        Aberto a oportunidades remotas, projetos freelance e conversas sobre engenharia e IA.
      </p>

      <div class="contact-links">
        <a href={`mailto:${d.email}`} class="contact-link contact-link--primary">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          {d.email}
        </a>

        <div class="contact-socials">
          <a
            href={`https://github.com/${d.github}`}
            target="_blank"
            rel="noopener"
            class="contact-social-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
            github.com/{d.github}
          </a>
          <a
            href={`https://linkedin.com/in/${d.linkedin}`}
            target="_blank"
            rel="noopener"
            class="contact-social-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            linkedin.com/in/{d.linkedin}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section--contact {
    background: var(--bg-surface);
  }
  .contact-inner {
    max-width: 640px;
  }
  .contact-title {
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 16px 0 20px;
  }
  .contact-title__accent {
    color: var(--accent);
  }
  .contact-desc {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 40px;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact-link--primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 500;
    padding: 18px 28px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-on);
    transition: opacity 0.2s, transform 0.2s;
    width: fit-content;
  }
  .contact-link--primary:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }
  .contact-socials {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .contact-social-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-family: var(--mono);
    color: var(--text-muted);
    padding: 12px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .contact-social-link:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
    transform: translateY(-1px);
  }
</style>
