---
import portfolio from "@/data/portfolio";
import SectionLabel from "./SectionLabel.astro";

const d = portfolio;
const featured = d.projects.filter((p) => p.featured);
const rest = d.projects.filter((p) => !p.featured);
const githubUrl = `https://github.com/${d.github}`;
---

<section id="projects" class="section section--alt">
  <div class="container">
    <div class="fade-in section-head">
      <SectionLabel text="Projetos" />
      <h2 class="section-title">O que construí</h2>
    </div>

    <div class="projects-bento">
      {
        featured.map((project) => (
          <article class="project-card project-card--featured fade-in">
            <div class="project-card__inner">
              <div class="project-card__top">
                <span class="project-card__period">{project.period}</span>
                <div class="project-card__title-row">
                  <h3 class="project-card__name">{project.name}</h3>
                  <span class="project-card__subtitle">{project.subtitle}</span>
                </div>
                <p class="project-card__desc">{project.description}</p>
              </div>

              <div class="project-card__details">
                <ul class="project-card__highlights">
                  {project.highlights.map((h) => (
                    <li class="project-card__highlight-item">
                      <span class="project-card__bullet" />
                      {h}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="project-card__footer">
                <div class="project-card__tags">
                  {project.tech.slice(0, 8).map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <a
                  href={project.link ?? githubUrl}
                  target="_blank"
                  rel="noopener"
                  class="project-card__link"
                >
                  GitHub
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }

      <div class="projects-bento__side">
        {
          rest.map((project) => (
            <article class="project-card fade-in">
              <div class="project-card__inner">
                <div class="project-card__top">
                  <span class="project-card__period">{project.period}</span>
                  <div class="project-card__title-row">
                    <h3 class="project-card__name">{project.name}</h3>
                    <span class="project-card__subtitle">{project.subtitle}</span>
                  </div>
                  <p class="project-card__desc">{project.description}</p>
                </div>

                <div class="project-card__details">
                  <ul class="project-card__highlights">
                    {project.highlights.map((h) => (
                      <li class="project-card__highlight-item">
                        <span class="project-card__bullet" />
                        {h}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="project-card__footer">
                  <div class="project-card__tags">
                    {project.tech.slice(0, 4).map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                    {project.tech.length > 4 && (
                      <span class="tag tag--more">+{project.tech.length - 4}</span>
                    )}
                  </div>
                  <a
                    href={project.link ?? githubUrl}
                    target="_blank"
                    rel="noopener"
                    class="project-card__link"
                  >
                    GitHub
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path
                        d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }

        <div class="projects-bento__github-card fade-in">
          <p class="projects-bento__github-text">
            Mais projetos e contribuições open source
          </p>
          <a href={githubUrl} target="_blank" rel="noopener" class="btn btn--ghost btn--sm">
            Ver GitHub
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-bento {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .projects-bento {
      grid-template-columns: 1fr;
    }
  }
  .projects-bento__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .project-card {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    transition: border-color 0.25s, transform 0.25s;
  }
  .project-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-3px);
  }
  .project-card--featured .project-card__inner {
    padding: 32px;
  }
  .project-card__inner {
    padding: 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 16px;
  }
  .project-card__top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-card__period {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .project-card__title-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .project-card__name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .project-card--featured .project-card__name {
    font-size: 32px;
  }
  .project-card__subtitle {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }
  .project-card__desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .project-card--featured .project-card__desc {
    font-size: 15px;
  }
  .project-card__details {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    opacity: 0;
  }
  .project-card:hover .project-card__details,
  .project-card:focus-within .project-card__details {
    max-height: 400px;
    opacity: 1;
  }
  .project-card__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 8px;
  }
  .project-card__highlight-item {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .project-card__bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 7px;
    flex-shrink: 0;
  }
  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: auto;
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-family: var(--mono);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 5px 12px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .project-card__link:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
  .projects-bento__github-card {
    border-radius: var(--radius);
    border: 1px dashed var(--border);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .projects-bento__github-text {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
