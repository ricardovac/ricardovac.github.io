---
import portfolio from "@/data/portfolio";

const links = [
  { id: "experience", label: "Experiência" },
  { id: "projects", label: "Projetos" },
  { id: "skills", label: "Skills" },
  { id: "contact", label: "Contato" },
];
---

<nav class="nav" id="site-nav">
  <div class="nav__inner">
    <a href="#hero" class="nav__logo" aria-label="Topo">
      <span class="nav__initials">RC</span>
    </a>

    <div class="nav__links" id="nav-links">
      {
        links.map((l) => (
          <a class="nav__link" data-section={l.id} href={`#${l.id}`}>
            {l.label}
          </a>
        ))
      }
      <button
        class="nav__theme"
        id="theme-toggle"
        type="button"
        aria-label="Alternar tema"
      >
        <svg class="nav__theme-icon nav__theme-icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="nav__theme-icon nav__theme-icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href={`mailto:${portfolio.email}`} class="nav__cta">Fale comigo</a>
    </div>

    <button class="nav__hamburger" id="nav-hamburger" type="button" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 0;
    transition: background 0.3s, border-color 0.3s, padding 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav--scrolled {
    background: oklch(0.08 0.015 240 / 0.92);
    backdrop-filter: blur(16px);
    border-color: var(--border);
    padding: 14px 0;
  }
  :global(:root[data-theme="light"]) .nav--scrolled {
    background: oklch(0.97 0.005 80 / 0.92);
  }
  .nav__inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
  }
  .nav__initials {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.2s;
  }
  .nav__initials:hover {
    color: var(--accent);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    padding: 7px 14px;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .nav__link:hover,
  .nav__link--active {
    color: var(--text);
    background: var(--bg-card);
  }
  .nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--text-muted);
    transition: color 0.2s, background 0.2s;
    margin-left: 4px;
  }
  .nav__theme:hover {
    color: var(--accent);
    background: var(--bg-card);
  }
  .nav__theme-icon--sun {
    display: none;
  }
  .nav__theme-icon--moon {
    display: block;
  }
  :global(:root[data-theme="light"]) .nav__theme-icon--sun {
    display: block;
  }
  :global(:root[data-theme="light"]) .nav__theme-icon--moon {
    display: none;
  }
  .nav__cta {
    font-size: 14px;
    font-weight: 500;
    padding: 7px 18px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-on);
    margin-left: 8px;
    transition: opacity 0.2s, transform 0.2s;
    display: inline-block;
  }
  .nav__cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
  }
  .nav__hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
  }
  @media (max-width: 700px) {
    .nav__hamburger {
      display: flex;
    }
    .nav__links {
      display: none;
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      padding: 16px;
      gap: 4px;
    }
    .nav__links--open {
      display: flex;
    }
    .nav__cta {
      margin-left: 0;
      text-align: center;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const links = document.getElementById("nav-links");
  const hamburger = document.getElementById("nav-hamburger");
  const toggle = document.getElementById("theme-toggle");
  const linkEls = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".nav__link[data-section]")
  );

  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle("nav--scrolled", window.scrollY > 40);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  linkEls.forEach((a) => {
    a.addEventListener("click", (e) => {
      const id = a.dataset.section;
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      window.scrollTo({ top: target.offsetTop - 80, behavior: "smooth" });
      links?.classList.remove("nav__links--open");
    });
  });

  hamburger?.addEventListener("click", () => {
    links?.classList.toggle("nav__links--open");
  });

  toggle?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme === "light" ? "light" : "dark";
    const next = current === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (_) {
      /* ignore */
    }
  });

  if ("IntersectionObserver" in window) {
    const sectionIds = linkEls.map((a) => a.dataset.section).filter(Boolean) as string[];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      linkEls.forEach((a) => {
        a.classList.toggle("nav__link--active", a.dataset.section === id);
      });
    };

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { threshold: 0.3 }
    );
    sections.forEach((el) => obs.observe(el));
  }
</script>
