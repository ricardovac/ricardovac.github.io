---
import portfolio from "@/data/portfolio";

const d = portfolio;
---

<section id="hero" class="hero">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__meta">
      <span class="badge">
        <span class="badge__dot"></span>
        {d.location}
      </span>
      {
        d.available && (
          <span class="badge">
            <span class="badge__dot badge__dot--green" />
            Disponível
          </span>
        )
      }
    </div>

    <h1 class="hero__name">
      <span class="hero__name-first">{d.firstName}</span>
      <span class="hero__name-last">{d.lastName}</span>
    </h1>

    <div class="hero__role">
      <span id="typewriter" data-strings={JSON.stringify(d.roleStrings)}></span>
      <span class="typewriter__cursor"></span>
    </div>

    <p class="hero__summary">{d.summary}</p>

    <div class="hero__actions">
      <a href="#projects" class="btn btn--primary" data-scroll="projects">
        Ver projetos
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href={`mailto:${d.email}`} class="btn btn--ghost">Entrar em contato</a>
    </div>

    <div class="hero__socials">
      <a
        href={`https://github.com/${d.github}`}
        target="_blank"
        rel="noopener"
        class="social-link"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
          ></path>
        </svg>
      </a>
      <a
        href={`https://linkedin.com/in/${d.linkedin}`}
        target="_blank"
        rel="noopener"
        class="social-link"
        aria-label="LinkedIn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
      <a
        href={`https://${d.website}`}
        target="_blank"
        rel="noopener"
        class="social-link"
        aria-label="Website"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>
    </div>

    <div class="hero__stats">
      {
        d.stats.map((s) => (
          <div class="stat">
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero__scroll-hint">
    <span>scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 100px 0 60px;
  }
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 100%);
  }
  .hero__glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(ellipse, oklch(0.5 0.13 277 / 0.32) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--border);
    font-size: 13px;
    font-family: var(--mono);
    color: var(--text-muted);
    background: var(--bg-card);
  }
  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }
  .badge__dot--green {
    background: oklch(0.72 0.17 145);
    box-shadow: 0 0 6px oklch(0.72 0.17 145 / 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
  .hero__name {
    font-size: clamp(60px, 10vw, 136px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin-bottom: 28px;
  }
  .hero__name-first {
    display: block;
  }
  .hero__name-last {
    display: block;
    color: var(--text-muted);
  }
  .hero__role {
    font-family: var(--mono);
    font-size: clamp(14px, 2vw, 20px);
    color: var(--accent);
    margin-bottom: 24px;
    min-height: 28px;
  }
  .typewriter__cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .hero__summary {
    max-width: 520px;
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 36px;
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .hero__socials {
    display: flex;
    gap: 12px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--bg-card);
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .social-link:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .hero__stats {
    display: flex;
    border-top: 1px solid var(--border);
    padding-top: 32px;
    flex-wrap: wrap;
    gap: 0;
  }
  .stat {
    padding: 0 32px 0 0;
    border-right: 1px solid var(--border);
    margin-right: 32px;
  }
  .stat:last-child {
    border-right: none;
    margin-right: 0;
  }
  .stat__value {
    display: block;
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .stat__label {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--mono);
    margin-top: 2px;
  }
  .hero__scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.45;
  }
  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--text-muted), transparent);
    animation: scrollDown 1.8s ease-in-out infinite;
  }
  @keyframes scrollDown {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 600px) {
    .stat {
      border-right: none;
      margin-right: 0;
      padding-right: 0;
      min-width: 110px;
    }
  }
</style>

<script>
  const node = document.getElementById("typewriter");
  if (node) {
    const raw = node.dataset.strings;
    let strings: string[] = [];
    try {
      strings = raw ? JSON.parse(raw) : [];
    } catch (_) {
      strings = [];
    }

    if (strings.length > 0) {
      const speed = 60;
      const pause = 2200;
      let idx = 0;
      let charIdx = 0;
      let deleting = false;

      const tick = () => {
        const current = strings[idx];
        if (!deleting) {
          charIdx += 1;
          node.textContent = current.slice(0, charIdx);
          if (charIdx >= current.length) {
            window.setTimeout(() => {
              deleting = true;
              tick();
            }, pause);
            return;
          }
          window.setTimeout(tick, speed);
        } else {
          charIdx -= 1;
          node.textContent = current.slice(0, Math.max(0, charIdx));
          if (charIdx <= 0) {
            deleting = false;
            idx = (idx + 1) % strings.length;
            window.setTimeout(tick, speed);
            return;
          }
          window.setTimeout(tick, speed / 2);
        }
      };

      tick();
    }
  }

  document.querySelectorAll<HTMLAnchorElement>("a[data-scroll]").forEach((a) => {
    a.addEventListener("click", (e) => {
      const id = a.dataset.scroll;
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      window.scrollTo({ top: target.offsetTop - 80, behavior: "smooth" });
    });
  });
</script>
