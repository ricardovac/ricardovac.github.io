---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import formatDate from "@/utils/formatDate";

const posts = (await getCollection("posts")).sort((a, b) => {
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});
---

<Layout title="Posts — Ricardo Clemente" description="Notas e escritos.">
  <Nav />
  <main class="section posts-page">
    <div class="container">
      <div class="section-head">
        <span class="section-label">
          <span class="section-label__line"></span>
          <span class="section-label__text">Posts</span>
        </span>
        <h1 class="section-title">Notas & escritos</h1>
      </div>

      {
        posts.length === 0 ? (
          <p class="posts-empty">Em breve.</p>
        ) : (
          <ul class="posts-list">
            {posts.map((post) => (
              <li>
                <a class="post-row" href={`/posts/${post.id}`}>
                  <div class="post-row__head">
                    <span class="post-row__title">{post.data.title}</span>
                    <span class="post-row__date">{formatDate(post.data.publishedAt)}</span>
                  </div>
                  <p class="post-row__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .posts-page {
    padding-top: 160px;
  }
  .posts-empty {
    color: var(--text-muted);
  }
  .posts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    transition: color 0.2s;
  }
  .post-row:hover {
    color: var(--accent);
  }
  .post-row__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .post-row__title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }
  .post-row__date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .post-row__desc {
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
